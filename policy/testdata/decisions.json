{
 "description": "The decision cases of the decision test set (record 0019, 'Deciding'): a bundle by name, a request (principal, action, resource, context in the JSON form of Cedar) and the entities the caller gives (the JSON entity format of Cedar; the action entities come from the schema), and the decision of the reference engine (cedar-policy): allow or deny, the policies that determined it and the policies that errored, each sorted; or a misfit, a request or entity that does not fit the schema. A bundle listed in gaps is one that an engine cannot load: that engine checks that it refuses the bundle as unsupported and skips its cases. A case with expect_go and gap is one where cedar-go gives another verdict: the Go package holds it to expect_go. The Go package and the Rust crate run every case.",
 "bundles": {
  "routes": {
   "schema": "entity Group in [Group];\nentity User in [Group] {\n  email: String,\n  groups: Set<String>,\n};\nentity Route {\n  site: String,\n  mode: String,\n};\naction read;\naction \"GET\", \"HEAD\" in [Action::\"read\"] appliesTo {\n  principal: [User],\n  resource: [Route],\n  context: { path: String, method: String },\n};\naction \"POST\" appliesTo {\n  principal: [User],\n  resource: [Route],\n  context: { path: String, method: String },\n};\n",
   "policies": {
    "open": "permit (principal, action, resource) when { resource.mode == \"open\" };",
    "admins": "permit (principal in Group::\"admins\", action, resource == Route::\"admin\");",
    "read": "permit (principal, action in Action::\"read\", resource) when { resource.mode == \"read\" };",
    "no-post-on-read": "forbid (principal, action == Action::\"POST\", resource) when { resource.mode == \"read\" };",
    "mail": "permit (principal, action, resource == Route::\"mail\") when { principal.email like \"*@example.com\" };",
    "api": "permit (principal, action, resource == Route::\"api\") when { context.path like \"/api/*\" && context.method == \"GET\" };",
    "overflow": "permit (principal, action, resource == Route::\"overflow\") when { 9223372036854775807 + 1 > 0 };"
   }
  },
  "linked": {
   "schema": "entity Group in [Group];\nentity User in [Group] {\n  email: String,\n  groups: Set<String>,\n};\nentity Route {\n  site: String,\n  mode: String,\n};\naction read;\naction \"GET\", \"HEAD\" in [Action::\"read\"] appliesTo {\n  principal: [User],\n  resource: [Route],\n  context: { path: String, method: String },\n};\naction \"POST\" appliesTo {\n  principal: [User],\n  resource: [Route],\n  context: { path: String, method: String },\n};\n",
   "policies": {
    "open": "permit (principal, action, resource) when { resource.mode == \"open\" };"
   },
   "templates": {
    "route-for": "permit (principal == ?principal, action in Action::\"read\", resource == ?resource);"
   },
   "links": [
    {
     "id": "alice-secret",
     "template": "route-for",
     "values": {
      "?principal": {
       "type": "User",
       "id": "alice"
      },
      "?resource": {
       "type": "Route",
       "id": "secret"
      }
     }
    }
   ]
  },
  "extensions": {
   "schema": "entity User {\n  level: Long,\n} tags String;\nentity Doc;\naction view appliesTo {\n  principal: [User],\n  resource: [Doc],\n  context: { ip: ipaddr, at: datetime },\n};\n",
   "policies": {
    "team": "permit (principal, action, resource) when { principal.hasTag(\"team\") && principal.getTag(\"team\") == \"core\" };",
    "net": "permit (principal, action, resource) when { context.ip.isInRange(ip(\"10.0.0.0/8\")) && principal.level >= 3 };",
    "before": "forbid (principal, action, resource) when { context.at < datetime(\"2026-01-01\") };"
   }
  }
 },
 "gaps": {
  "linked": {
   "go": "cedar-go has no templates: a bundle with a template or a link is refused (unsupported)"
  }
 },
