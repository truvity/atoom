go 1.27.0

toolchain go1.27.4

// Every Go module of the repository, listed explicitly (docs/plan.md, section 5). Development only: a consumer resolves the
// modules through their own go.mod files and the tags of one release.
use (
	./blob
	./common
	./destination
	./index
	./key
	./key/awskms
	./key/conformance
	./key/pinrelease
	./key/slotplan
	./key/software
	./key/yubikeypiv
	./socket
	./source
	./store
	./store/dynamodb
	./tools
	./transport
)

replace github.com/truvity/atoom/blob v0.1.0 => ./blob

replace github.com/truvity/atoom/common v0.1.0 => ./common

replace github.com/truvity/atoom/destination v0.1.0 => ./destination

