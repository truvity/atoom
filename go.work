go 1.27.0

toolchain go1.27.4

// Every Go module of the repository, listed explicitly (docs/archive/extraction-plan.md, section 5). Development only: a consumer resolves the
// modules through their own go.mod files and the tags of one release.
use (
	./blob
	./blocks/seal
	./blocks/token
	./common
	./destination
	./index
	./key
	./key/awskms
	./key/conformance
	./key/pinrelease
	./key/slotplan
	./key/software
	./key/yubikeypiv
	./policy
	./socket
	./source
	./source/appconfig
	./source/file
	./store
	./store/dynamodb
	./tools
	./transport
	./transport/nats
	./transport/sqs
)

